# Copy to .env (gitignored, chmod 600) - `make up` does this for you via
# scripts/setup_env.py, filling keys from ~/.config/agentforge/ without
# printing them. Never commit real values.

# Required: OpenAI key with gpt-realtime(-mini), gpt-live-transcribe, gpt-4o-mini-tts.
OPENAI_API_KEY=
# Optional: enables the cascade-haiku translator profile.
# Direct Anthropic adapter: kept in code but DISABLED (key dropped in M4; Haiku
# runs via OpenRouter). Only set these if the direct route is re-approved.
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=

# OpenRouter MT profile (Haiku route, approved by Andre in M4). Filled by setup_env.py from openrouter_api_key.
OPENROUTER_API_KEY=

# ElevenLabs (free tier, 10k credits/month). Host PATH to the key file; it is
# mounted as a compose secret. Real calls only when ELEVENLABS_ENABLED=1.
ELEVENLABS_KEY_PATH=
ELEVENLABS_ENABLED=0

# Optional overrides of config/app.yaml
# REALTIME_MODEL=gpt-realtime-mini   # override the default gpt-realtime (cheaper, for development)
# MT_MODEL=
# CASCADE_STT=openai_live
# CASCADE_MT=openai
# CASCADE_TTS=openai
# A11 session recording (off by default; overrides recording.enabled in config/app.yaml)
# RECORDING_ENABLED=1
APP_PORT=8740

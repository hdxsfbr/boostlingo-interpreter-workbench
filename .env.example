# Copy to .env (gitignored, chmod 600) - `make up` does this for you via
# scripts/setup_env.py, filling keys from ~/.config/agentforge/ without
# printing them. Never commit real values.

# Required: OpenAI key with gpt-realtime(-mini), gpt-live-transcribe, gpt-4o-mini-tts.
OPENAI_API_KEY=
# Optional: enables the cascade-haiku translator profile.
ANTHROPIC_API_KEY=

# ElevenLabs (free tier, 10k credits/month). Host PATH to the key file; it is
# mounted as a compose secret. Real calls only when ELEVENLABS_ENABLED=1.
ELEVENLABS_KEY_PATH=
ELEVENLABS_ENABLED=0

# Optional overrides of config/app.yaml
# REALTIME_MODEL=gpt-realtime-mini
# MT_MODEL=
# CASCADE_STT=openai_live
# CASCADE_MT=openai
# CASCADE_TTS=openai
APP_PORT=8740
